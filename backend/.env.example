# Copy to backend/.env  (npm run setup does this for you).
# The defaults below work as-is for local development with `npm run db:up`.

PORT=5000
NODE_ENV=development

# ---- Database ----
# Local dev DB from docker-compose.yml (npm run db:up), published on host port 5433.
DATABASE_URL=postgresql://jobtune:jobtune@localhost:5433/jobtune?sslmode=disable
# Cloud Postgres (e.g. Neon) - SSL is enabled automatically for non-localhost hosts:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Must be >= 32 chars or the server refuses to start. `npm run setup` generates one.
# Manual: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Origin allowed by CORS (the Vite dev server). Ignored when the frontend calls /api via the Vite proxy.
FRONTEND_URL=http://localhost:5173

# ---- AI ----
# MOCK_AI=true skips every LLM call and returns canned text, so the app boots with no keys but AI
# features return placeholder output. Set false and configure a provider below for real results.
MOCK_AI=true

# AI_PROVIDER options: anthropic | gemini | lmstudio
# anthropic = Claude (best quality)   gemini = Google Gemini Flash   lmstudio = local models
AI_PROVIDER=gemini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LM Studio (OpenAI-compatible). Only needed when AI_PROVIDER=lmstudio.
# LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_URL=
LM_STUDIO_MODEL_RESUME=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_MODEL_INTERVIEW=meta-llama-3.1-8b-instruct
LM_STUDIO_MODEL_JOB=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_MODEL_SKILLS=qwen/qwen3.5-9b
LM_STUDIO_MODEL_ROADMAP=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_MODEL_EMBED=text-embedding-nomic-embed-text-v1.5@q3_k_m

# ---- Job search (optional) ----
# Only needed for the 'adzuna' job source; the 'mock' and 'remotive' sources need no keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
