PORT=3000

# PostgreSQL / Neon Connection
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

JWT_SECRET=
NODE_ENV=production

# LM Studio Configuration — Local LLM Inference
# Public URL of the tunnel exposing your LM Studio PC (e.g. Cloudflare Tunnel)
LM_STUDIO_URL=https://your-tunnel-subdomain.trycloudflare.com/v1

LM_STUDIO_MODEL_RESUME=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_MODEL_INTERVIEW=meta-llama-3.1-8b-instruct
LM_STUDIO_MODEL_JOB=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_MODEL_SKILLS=qwen/qwen3.5-9b
LM_STUDIO_MODEL_ROADMAP=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_MODEL_EMBED=text-embedding-nomic-embed-text-v1.5@q3_k_m

MOCK_AI=false

# ── AI Provider Configuration ──
# AI_PROVIDER options: anthropic | gemini | lmstudio
# anthropic = Claude (best quality, recommended for production)
# gemini    = Google Gemini Flash (fast, good for high-volume)
# lmstudio  = Local LLMs (free, requires local setup)
AI_PROVIDER=gemini

# Anthropic Claude (premium quality)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# URL of your deployed Vercel frontend, for CORS
FRONTEND_URL=https://your-app.vercel.app
