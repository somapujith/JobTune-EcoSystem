# Defaults for the LOCAL Docker API container (see ../docker-compose.yml).
# Committed on purpose: nothing here is a real secret.
#
# To override anything (AI keys, MOCK_AI=false, ...) create backend/.env.docker.local
# (gitignored, loaded after this file). DATABASE_URL and PORT are pinned in
# docker-compose.yml and cannot be overridden from here, so the container can
# never be pointed at the production Neon database by accident.

NODE_ENV=development

# Local-only signing key (auth middleware requires >= 32 chars). Not used in prod.
JWT_SECRET=local-dev-only-secret-not-for-production-use

# Skip real LLM calls so the API works with no keys / no LM Studio.
# Set MOCK_AI=false in .env.docker.local and supply provider keys to use real AI.
MOCK_AI=true

FRONTEND_URL=http://localhost:5173

# LM Studio running on the host machine (only used when MOCK_AI=false, AI_PROVIDER=lmstudio)
LM_STUDIO_URL=http://host.docker.internal:1234/v1
