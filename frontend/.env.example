# Local development needs NO frontend/.env at all.
#
# With VITE_API_URL unset the app calls same-origin `/api`, and the Vite dev server
# proxies that to the backend (default http://localhost:5000 - see vite.config.js).
# Only set the variables below if your backend runs somewhere else.

# Backend the Vite dev server proxies /api to (dev only; not baked into the build).
# VITE_API_PROXY=http://localhost:5000

# Point the app straight at a backend instead of using the proxy. This is baked into
# the production build; the backend must then allow this origin via CORS (FRONTEND_URL).
# VITE_API_URL=https://jobtune-backend-14k0.onrender.com/api
